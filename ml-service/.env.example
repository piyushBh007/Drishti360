# =============================================================================
# Drishti360 ML Service — Production Environment Variables
# =============================================================================
# Copy to .env for local dev. Set these on Render Dashboard for production.
# NEVER commit .env with real secrets.
# =============================================================================

# --- Server ---
PORT=5001

# --- YOLO Model ---
# File name of the YOLO model weights (must exist in the ml-service/ directory).
YOLO_MODEL=yolov8n.pt
YOLO_CONFIDENCE=0.25
YOLO_INFERENCE_FPS=3

# --- Backend URL ---
# Used by the /predict endpoint to POST aggregated activity to the Node backend.
# Set to the actual Render backend URL in production.
# Example: https://drishti360-backend.onrender.com
BACKEND_URL=http://localhost:3000

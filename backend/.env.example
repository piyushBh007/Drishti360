# =============================================================================
# Drishti360 Backend — Production Environment Variables
# =============================================================================
# Copy this file to .env for local development.
# NEVER commit .env with real secrets to version control.
# On Render: set all variables via the Render Dashboard → Environment.
# =============================================================================

# --- Server ---
PORT=3000

# --- Database ---
# OPTION A (Recommended for Supabase/Render):
#   Set DATABASE_URL as the full Postgres connection string.
#   Supabase connection string format:
#   postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# OPTION B (fallback — used only when DATABASE_URL is not set):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=drishti360
DB_USER=postgres
DB_PASSWORD=your_password_here
# Set DB_SSL=false only for local development without SSL.
DB_SSL=false

# --- Authentication ---
# REQUIRED: Change this to a long random string in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_IN_PRODUCTION

# --- ML Service ---
# URL of the deployed Python ML/YOLO service.
# Must be set to the actual Render ML service URL in production.
# Example: https://drishti360-ml.onrender.com
ML_SERVICE_URL=http://localhost:5001

# --- CORS ---
# Comma-separated list of allowed origins.
# Leave empty to allow all origins (development only).
# In production, set to your actual origin or leave empty for Android native apps
# (Android native HTTP clients do not send an Origin header).
CORS_ORIGIN=

# --- CCTV / IP Camera (optional) ---
# If you have a real RTSP stream, provide it here.
# It will override the database stream_url for IP_CAMERA type cameras.
# RTSP_STREAM_URL=rtsp://your-camera-host/stream

# --- Render Notes ---
# 1. Set DATABASE_URL from your Supabase connection string.
# 2. Set JWT_SECRET to a strong random value.
# 3. Set ML_SERVICE_URL to your deployed ML service URL.
# 4. PORT is automatically set by Render — do not override it.
